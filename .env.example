# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Database (MySQL) ──────────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=yourMySQLPassword
DB_ROOT_PASSWORD=yourMySQLRootPassword

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=changethissecrettoasecurerandomstringatleast64charslong

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
